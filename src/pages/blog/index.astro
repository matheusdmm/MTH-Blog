---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => ({
    ...p,
    readTime: p.body
      ? Math.ceil(p.body.split(/\s+/).filter(Boolean).length / 200)
      : undefined,
  }));

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`Blog — ${SITE_TITLE}`}
      description="Artigos sobre tecnologia, desenvolvimento e criatividade."
    />
  </head>
  <body>
    <Header />

    <main class="main">
      <h1 class="page-title">Blog</h1>

      {allTags.length > 0 && (
        <div class="filters" role="group" aria-label="Filter by tag">
          <button class="filter active" data-filter="all">Todos</button>
          {allTags.map((tag) => (
            <button class="filter" data-filter={tag}>{tag}</button>
          ))}
        </div>
      )}

      <ul class="post-list" id="posts-grid">
        {posts.map((post) => (
          <li data-tags={post.data.tags?.join(',') ?? ''}>
            <div class="post-row">
              <div class="post-info">
                <a href={`/blog/${post.id}/`} class="post-title">{post.data.title}</a>
                {post.data.description && (
                  <span class="post-desc">{post.data.description}</span>
                )}
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="post-tags">
                    {post.data.tags.map((t) => <a href={`/blog?tag=${t}`} class="tag">{t}</a>)}
                  </span>
                )}
              </div>
              <span class="post-date">
                <FormattedDate date={post.data.pubDate} />
                {post.readTime && <span class="read-time">· {post.readTime} min</span>}
              </span>
            </div>
          </li>
        ))}
      </ul>

      {posts.length === 0 && (
        <p class="empty">Nenhum artigo publicado ainda.</p>
      )}
    </main>

    <Footer />

    <script>
      const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const items = document.querySelectorAll<HTMLLIElement>('[data-tags]');

      function applyFilter(tag: string) {
        btns.forEach((b) => b.classList.remove('active'));
        const active = document.querySelector<HTMLButtonElement>(`[data-filter="${tag}"]`);
        (active ?? document.querySelector<HTMLButtonElement>('[data-filter="all"]'))!.classList.add('active');
        items.forEach((item) => {
          if (tag === 'all') {
            item.hidden = false;
          } else {
            const tags = item.dataset.tags?.split(',').filter(Boolean) ?? [];
            item.hidden = !tags.includes(tag);
          }
        });
      }

      btns.forEach((btn) => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter!));
      });

      // Pre-select tag from URL param (?tag=X)
      const initialTag = new URL(window.location.href).searchParams.get('tag');
      if (initialTag) applyFilter(initialTag);
    </script>
  </body>
</html>

<style>
  .main {
    max-width: 680px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin: 0 0 2rem;
    line-height: 1;
  }

  /* ── Filters ──────────────────────────────── */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2.25rem;
  }

  /* Filter buttons inherit the global .tag spec, add interactivity */
  .filter {
    font-family: 'Mozilla Text', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2em 0.55em;
    border-radius: 3px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg-muted);
    line-height: 1.6;
    cursor: pointer;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
  }

  .filter:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  .filter.active {
    background: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  /* ── Post list ─────────────────────────────── */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .post-list li { border-bottom: 1px solid var(--border); }

  .post-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 0;
    color: var(--fg);
  }

  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-title {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.12s;
  }

  .post-title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-title:hover { color: var(--accent-hover); }

  .post-tags .tag {
    position: relative;
    z-index: 1;
    text-decoration: none;
  }

  .post-tags .tag:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  .post-desc {
    font-size: 0.845rem;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }

  .post-date {
    font-size: 0.78rem;
    color: var(--fg-muted);
    white-space: nowrap;
    padding-top: 0.15rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .read-time {
    font-size: 0.72rem;
    color: var(--fg-muted);
    opacity: 0.7;
  }

  .empty {
    color: var(--fg-muted);
    font-size: 0.95rem;
    padding: 3rem 0;
  }

  @media (max-width: 520px) {
    .post-row { flex-direction: column; gap: 0.4rem; }
    .post-date { padding-top: 0; }
  }
</style>
