---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { readTime } from '../../utils';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => ({ ...p, readTime: readTime(p.body) }));

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`Blog — ${SITE_TITLE}`}
      description="Artigos sobre tecnologia, desenvolvimento e criatividade."
    />
  </head>
  <body class="page-blog">
    <Header />

    <main class="main">
      <p class="page-kicker">MTH / ARQUIVO</p>
      <h1 class="page-title">Tudo que publiquei<span>.</span></h1>
      <p class="page-intro">Software, pedais de guitarra, RPG e o que mais me deu vontade de desmontar para entender.</p>

      {allTags.length > 0 && (
        <div class="tag-filters" role="group" aria-label="Filtrar por assunto">
          <button class="tag-filter" type="button" data-filter="all" aria-pressed="true" aria-controls="posts-grid">Todos</button>
          {allTags.map((tag) => (
            <button class="tag-filter" type="button" data-filter={tag} aria-pressed="false" aria-controls="posts-grid">{tag}</button>
          ))}
        </div>
      )}

      <PostList posts={posts} id="posts-grid" />

      {posts.length === 0 && (
        <p class="empty">Nenhum artigo publicado ainda.</p>
      )}
    </main>

    <Footer />

    <script>
      const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const items = document.querySelectorAll<HTMLLIElement>('[data-tags]');

      function applyFilter(tag: string) {
        const active = [...btns].find((button) => button.dataset.filter === tag) ?? btns[0];
        btns.forEach((button) => button.setAttribute('aria-pressed', String(button === active)));
        items.forEach((item) => {
          if (tag === 'all') {
            item.hidden = false;
          } else {
            const tags = item.dataset.tags?.split(',').filter(Boolean) ?? [];
            item.hidden = !tags.includes(tag);
          }
        });
      }

      btns.forEach((btn) => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter!));
      });

      // Pre-select tag from URL param (?tag=X)
      const initialTag = new URL(window.location.href).searchParams.get('tag');
      if (initialTag) applyFilter(initialTag);
    </script>
  </body>
</html>
