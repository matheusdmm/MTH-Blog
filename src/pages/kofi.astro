<style>
  .kofi-btn {
    display: inline-block;
    margin: 1rem 0 2rem;
    padding: 0.7rem 1.75rem;
    border: 2px solid var(--border);
    color: var(--fg);
    font-size: 1rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: var(--shadow);
    font-family: 'Courier New', Courier, monospace;
    background: var(--bg);
  }

  .kofi-btn:hover {
    background: var(--fg);
    color: var(--bg);
    box-shadow: none;
    transform: translate(4px, 4px);
    text-decoration: none;
  }

  .support-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .support-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    border: 2px solid var(--border);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    background: var(--bg);
  }

  .support-card:hover {
    transform: translate(4px, 4px);
    box-shadow: none;
  }

  .support-card-info {
    flex: 1;
  }

  .support-card-title {
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.4rem;
  }

  .support-card-desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
    margin: 0;
  }

  .pix-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .pix-qr img {
    border: 2px solid var(--border);
    display: block;
  }

  .pix-label {
    font-size: 0.7rem;
    font-family: 'Courier New', Courier, monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .support-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .pix-qr {
      width: 100%;
      align-items: flex-start;
    }

    .pix-qr img {
      width: 140px;
      height: 140px;
    }
  }
</style>
