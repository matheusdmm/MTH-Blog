---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SUPPORT } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Support — ${SITE_TITLE}`} description="Support my work" />
  </head>
  <body class="page-kofi">
    <Header />
    <main>
      <h1>Me apoia com um cafézinho</h1>
      <p>
        Se alguma coisa que eu fiz, seja um post, uma idéia, um projeto que
        achou massa ou até mesmo uma ferramenta, me paga um cafézinho, café
        sempre vai bem!
      </p>

      <a href={SUPPORT} target="_blank" class="kofi-btn">
        Me paga um cafézinho, link pro Mercado Pago ☕
      </a>
    </main>
    <Footer />
  </body>
</html>
