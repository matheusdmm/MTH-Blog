---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import NowListening from '../components/NowListening.astro';
import PostList from '../components/PostList.astro';
import { SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description="O caderno de Matheus: software, música, RPG e as coisas que aprendeu construindo."
    />
  </head>
  <body class="page-home">
    <Header />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title"><span class="hello">Buenas, sou o</span><span class="name">Matheus.</span></h1>
            <p class="hero-lead">Trabalho com software há mais de dez anos. Fora do editor, tô compondo, mexendo em pedais ou em uma mesa de RPG.</p>
            <p class="hero-detail">Aqui anoto o que deu certo, o que quebrou e o que descobri tentando.</p>
            <div class="hero-actions">
              <a href="/blog">Ler as anotações</a>
              <a href="/img">Álbum de fotos</a>
              <a href="/about">Quem sou eu</a>
            </div>
          </div>
          <figure class="portrait">
            <img src="/avatar.jpg" alt="Matheus, em frente a uma árvore" width="460" height="460" loading="eager" />
            <figcaption>MTH em pessoa</figcaption>
          </figure>
        </div>
      </section>

      <nav class="topics" aria-label="Assuntos do blog">
        <span class="topics-label">EM ALTA</span>
        <a href="/blog?tag=dev"><span>01</span> Software</a>
        <a href="/blog?tag=music"><span>02</span> Música</a>
        <a href="/blog?tag=dnd"><span>03</span> RPG</a>
      </nav>

      <NowListening />

      {
        recentPosts.length > 0 && (
          <section class="recent" aria-labelledby="recent-title">
            <div class="section-heading">
              <div><h2 id="recent-title">Caderninho de idéias.</h2></div>
              <a href="/blog" class="all-link">Arquivo completo</a>
            </div>
            <PostList posts={recentPosts} />
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>
