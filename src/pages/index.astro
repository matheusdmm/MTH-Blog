---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
  .filter((p) => !p.data.hidden)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description="Engenheiro de software, músico e escritor. Artigos sobre tecnologia, código e criatividade."
    />
  </head>
  <body>
    <Header />

    <main class="main">
      <section class="intro">
        <p class="font-mono font-semibold text-fg text-[clamp(1.875rem,5vw,2.75rem)] tracking-[-0.01em] mb-6 after:content-['▌'] after:ml-[0.15em] after:animate-blink">Matheus aqui.</p>
        <p>
          Engenheiro de software de dia, músico e escritor sempre que eu tenho
          um tempo livre — às vezes pode ser tudo isso misturado também, depende
          do café.
        </p>
        <p>
          Eu passei mais de 10 anos resolvendo uma série de problemas com
          código, indo desde rede em fibra óptica, passando por servidores Linux
          e salas de aula, e mais recentemente como líder de projeto na Philip
          Morris International. No meio do caminho eu acabei aprendendo que nem
          sempre a melhor solução pode ser a mais óbvia.
        </p>
        <p>
          Fora do terminal você me encontra compondo, tocando ou escrevendo.
          Esse blog é onde tecnologia, criatividade e o que ficar no meio do
          caminho se encontram.
        </p>
        <p>
          My blog focus primarily on PT-BR content, however, some content may be
          written in english as well if I feel that it better or the reach would
          be broader.
        </p>
      </section>

      {
        recentPosts.length > 0 && (
          <section class="recent">
            <h2 class="section-label">Publicações recentes</h2>
            <PostList posts={recentPosts} />
            <a href="/blog" class="all-link">
              Ver todas as publicações →
            </a>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>

<style>
  .main {
    max-width: 680px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  /* ── Intro ─────────────────────────────────── */
  .intro {
    margin-bottom: 4rem;
  }

  .intro p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--fg-muted);
    margin-bottom: 1.25rem;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  /* ── Recent posts ──────────────────────────── */
  .section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 1.25rem;
  }

  .all-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.12s;
  }

  .all-link:hover {
    color: var(--accent-hover);
  }
</style>
