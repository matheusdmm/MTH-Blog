---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";
import { useTranslations } from "../../i18n/translations";

const t = useTranslations('en');
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={t('site.description')} />
    </head>
    <body>
        <Header />
        <main>
            <h1>Hey, I'm Matheus!</h1>
            <p>
                Software engineer by day, musician and writer whenever I can get
                away with it (sometimes all at once, depending on the coffee).
            </p>
            <p>
                I've spent over 10 years solving complex problems with code,
                going through optical fiber networks, Linux servers, classrooms,
                and now leading projects at Philip Morris International. Along
                the way I learned that the best solution is rarely the most
                obvious one — and that patience to truly understand a problem is
                worth more than any trendy framework.
            </p>
            <p>
                Outside the terminal, you'll find me composing, playing, or
                writing. I believe that coding and creating art come from the
                same place: the urge to turn an idea into something other people
                can actually feel.
            </p>
            <p>
                This blog is where both sides of me meet — technology,
                creativity, and everything in between.
            </p>
        </main>
        <Footer />
    </body>
</html>
