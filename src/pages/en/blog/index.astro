---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { useTranslations } from '../../../i18n/translations';

const t = useTranslations('en');

const posts = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('en/') && !p.data.hidden)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title=`Blog — ${SITE_TITLE}` description={t('site.description')} />
  </head>
  <body>
    <Header />
    <main class="wide">
      <section>
        {allTags.length > 0 && (
          <div class="tag-filters">
            <button class="tag-filter-btn active" data-filter="all">All</button>
            {allTags.map((tag) => (
              <button class="tag-filter-btn" data-filter={tag}>{tag}</button>
            ))}
          </div>
        )}
        <ul class="post-list">
          {
            posts.map((post) => (
              <li
                class={post.data.heroImage ? 'has-image' : ''}
                data-tags={post.data.tags?.join(',') ?? ''}
              >
                <a href={`/en/blog/${post.id.replace('en/', '')}/`}>
                  {post.data.heroImage && (
                    <Image
                      width={160}
                      height={100}
                      src={post.data.heroImage}
                      alt={post.data.title}
                    />
                  )}
                  <div class="post-info">
                    <h4 class="post-title">{post.data.title}</h4>
                    <p>{post.data.description}</p>
                    <p class="post-date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="post-tags">
                        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                      </div>
                    )}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const items = document.querySelectorAll<HTMLLIElement>('[data-tags]');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tag = btn.dataset.filter!;

          buttons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          items.forEach((item) => {
            if (tag === 'all') {
              item.hidden = false;
            } else {
              const tags = item.dataset.tags?.split(',').filter(Boolean) ?? [];
              item.hidden = !tags.includes(tag);
            }
          });
        });
      });
    </script>
  </body>
</html>
