---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getPhotos } from '../../utils/photos';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return photos.map((photo, index) => ({
    params: { slug: photo.id },
    props: { photo, newer: photos[index - 1], older: photos[index + 1] },
  }));
}

interface Props {
  photo: CollectionEntry<'img'>;
  newer?: CollectionEntry<'img'>;
  older?: CollectionEntry<'img'>;
}

const { photo, newer, older } = Astro.props;
const { title, caption, date, tags, location, image } = photo.data;
const dateLabel = date.toLocaleDateString('pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const mapUrl = location?.latitude !== undefined && location.longitude !== undefined
  ? `https://www.openstreetmap.org/?mlat=${location.latitude}&mlon=${location.longitude}#map=13/${location.latitude}/${location.longitude}`
  : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`${title ?? dateLabel} - IMG - ${SITE_TITLE}`}
      description={caption}
      image={image}
    />
  </head>
  <body>
    <Header />
    <main class="photo-page">
      <nav class="back" aria-label="Voltar para a galeria"><a href="/img"><span aria-hidden="true">←</span> Todas as imagens</a></nav>
      <article>
        <figure class="photo">
          <Image src={image} alt={photo.data.alt} width={1600} loading="eager" fetchpriority="high" />
        </figure>
        <div class="details">
          <p class="kicker">MTH / IMAGENS</p>
          <h1>{title ?? dateLabel}<span>.</span></h1>
          <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
          <p class="caption">{caption}</p>
          {tags.length > 0 && <ul class="tags" aria-label="Assuntos">{tags.map((tag) => <li>{tag}</li>)}</ul>}
          {location && (
            <p class="location">
              <span aria-hidden="true">⌖</span> {location.name}
              {mapUrl && <a href={mapUrl} target="_blank" rel="noopener noreferrer">Ver no mapa ↗</a>}
            </p>
          )}
        </div>
      </article>
      <nav class="photo-nav" aria-label="Navegar pelas imagens">
        {newer ? <a href={`/img/${newer.id}`}><span>← Mais recente</span><strong>{newer.data.title ?? newer.data.alt}</strong></a> : <span />}
        {older ? <a href={`/img/${older.id}`}><span>Mais antiga →</span><strong>{older.data.title ?? older.data.alt}</strong></a> : <span />}
      </nav>
    </main>
    <Footer />
  </body>
</html>

<style>
  .photo-page { max-width: 1440px; min-height: 65svh; margin: 0 auto; padding: 1.5rem 1rem 5rem; }
  .back { margin-bottom: 1.5rem; font-size: .82rem; font-weight: 600; }
  .back a { color: var(--fg-muted); }
  .back a:hover { color: var(--accent); }
  .back span { margin-right: .45rem; }
  article { display: grid; gap: 2rem; }
  .photo { display: grid; place-items: center; min-width: 0; margin: 0; background: #fff; }
  .photo :global(img) { width: 100%; height: auto; max-height: 78svh; object-fit: contain; }
  .details { max-width: 560px; }
  .kicker { margin: 0 0 1.2rem; color: var(--accent); font-size: .68rem; font-weight: 700; letter-spacing: .17em; }
  h1 { margin: 0 0 .65rem; font-size: clamp(2.1rem, 5vw, 4rem); letter-spacing: -.055em; line-height: 1.1; }
  h1 span { color: var(--accent); }
  time { color: var(--fg-muted); font-size: .84rem; }
  .caption { margin: 1.5rem 0 0; font-size: 1.06rem; line-height: 1.75; white-space: pre-line; }
  .tags { display: flex; flex-wrap: wrap; gap: .55rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  .tags li { border: 1px solid var(--border); padding: .2rem .55rem; color: var(--fg-muted); font-size: .72rem; }
  .location { display: flex; flex-wrap: wrap; gap: .35rem; align-items: baseline; margin: 1.75rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--fg-muted); font-size: .85rem; }
  .location > span { color: var(--accent); font-size: 1.25rem; }
  .location a { margin-left: auto; }
  .photo-nav { display: flex; justify-content: space-between; gap: 2rem; margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .photo-nav a { display: flex; flex-direction: column; max-width: 45%; gap: .3rem; color: var(--fg); }
  .photo-nav a:last-child { margin-left: auto; text-align: right; }
  .photo-nav a:hover { color: var(--accent); }
  .photo-nav span { color: var(--fg-muted); font-size: .75rem; }
  .photo-nav strong { font-size: .9rem; font-weight: 600; line-height: 1.3; }
  @media (min-width: 900px) {
    .photo-page { padding: 2rem 2rem 7rem; }
    .back { margin-bottom: 2rem; }
    article { grid-template-columns: minmax(0, 1.8fr) minmax(280px, .8fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
    .details { position: sticky; top: 100px; padding-top: 1rem; }
  }
</style>
