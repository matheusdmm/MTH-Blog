---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PhotoZoom from '../../components/PhotoZoom.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { SITE_TITLE } from '../../consts';
import { getPhotos, getRelatedPhotos } from '../../utils/photos';
import { photoTagUrl } from '../../utils/photo-tags';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return photos.map((photo, index) => ({
    params: { slug: photo.id },
    props: { photo, newer: photos[index - 1], older: photos[index + 1], related: getRelatedPhotos(photo, photos) },
  }));
}

interface Props {
  photo: CollectionEntry<'img'>;
  newer?: CollectionEntry<'img'>;
  older?: CollectionEntry<'img'>;
  related: CollectionEntry<'img'>[];
}

const { photo, newer, older, related } = Astro.props;
const { title, caption, date, tags, location, image } = photo.data;
const dateLabel = date.toLocaleDateString('pt-BR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const mapUrl = location?.latitude !== undefined && location.longitude !== undefined
  ? `/img/mapa?foto=${encodeURIComponent(photo.id)}`
  : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`${title ?? dateLabel} - IMG - ${SITE_TITLE}`}
      description={caption}
      image={image}
    />
  </head>
  <body class="page-photo">
    <Header />
    <main class="photo-page">
      <nav class="back" aria-label="Voltar para a galeria"><a href="/img">Todas as imagens</a></nav>
      <article>
        <PhotoZoom image={image} alt={photo.data.alt} title={title ?? dateLabel} />
        <div class="details">
          <h1>{title ?? dateLabel}<span>.</span></h1>
          <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
          <p class="caption">{caption}</p>
          {tags.length > 0 && (
            <ul class="tags" aria-label="Assuntos">
              {tags.map((tag) => <li><a href={photoTagUrl(tag)}>{tag}</a></li>)}
            </ul>
          )}
          {location && (
            <p class="location">
              <span aria-hidden="true">⌖</span> {location.name}
              {mapUrl && <a href={mapUrl}>Ver no mapa</a>}
            </p>
          )}
        </div>
      </article>
      {related.length > 0 && (
        <section class="related-photos" aria-labelledby="related-photos-heading">
          <h2 id="related-photos-heading">Fotos relacionadas<span>.</span></h2>
          <p>Mais registros com assuntos em comum.</p>
          <PhotoGrid photos={related} label="Fotos relacionadas" />
        </section>
      )}
      <nav class="photo-nav" aria-label="Navegar pelas imagens">
        {newer ? <a href={`/img/${newer.id}`}><span>Mais recente</span><strong>{newer.data.title ?? newer.data.alt}</strong></a> : <span />}
        {older ? <a href={`/img/${older.id}`}><span>Mais antiga</span><strong>{older.data.title ?? older.data.alt}</strong></a> : <span />}
      </nav>
    </main>
    <Footer />
  </body>
</html>
