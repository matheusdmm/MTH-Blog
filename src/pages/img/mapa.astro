---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ImgHeading from '../../components/ImgHeading.astro';
import ImgTabs from '../../components/ImgTabs.astro';
import PhotoMap from '../../components/PhotoMap.astro';
import { SITE_TITLE } from '../../consts';
import { getPhotos } from '../../utils/photos';

const photos = await getPhotos();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Mapa · IMG — ${SITE_TITLE}`} description="As fotografias e os lugares onde foram feitas." />
  </head>
  <body>
    <Header />
    <main class="map-page">
      <ImgHeading />
      <ImgTabs active="map" />
      <PhotoMap photos={photos} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .map-page { max-width: 1280px; min-height: 60svh; margin: 0 auto; padding: 2rem 1rem 5rem; }
  @media (min-width: 700px) {
    .map-page { padding: 5.5rem 2rem 8rem; }
  }
</style>
