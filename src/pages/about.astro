---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const avatarUrl = '/avatar.jpg';

const skills = {
  languages: ['JavaScript', 'TypeScript', 'HTML', 'CSS', 'Go', 'Java', 'Python', 'C#/.NET'],
  technologies: ['React', 'Next.js', 'NestJS', 'Jest', 'Tailwind', 'Docker', 'MongoDB', 'Firebase', 'MySQL', 'Node.js', 'Git', 'Linux/Unix', 'Azure', 'AWS', 'Figma'],
  soft: ['Agile/Scrum', 'Self-driven', 'Fast learner', 'Team Player', 'Communicative', 'Adaptable'],
};

const experience = [
  {
    role: 'Project Leader',
    company: 'Philip Morris International',
    period: 'Mai 2022 — Presente',
    bullets: [
      'Gestão de sprints, monitoramento de projetos, usabilidade e automação entre equipes de dev e negócios.',
      'Utilizei JavaScript e Python diariamente para entregar funcionalidades e criar benchmarks com 50% de melhoria de performance.',
    ],
  },
  {
    role: 'Senior Frontend Developer',
    company: 'Bosch USA',
    period: 'Out 2022 — Dez 2022',
    bullets: [
      'Liderei a migração de páginas legadas para React, incluindo i18n, roteamento e carrinho de compras reformulado.',
      'Migração completa entregue em 90 dias.',
    ],
  },
  {
    role: 'Staff Developer',
    company: 'Discovery Bowl',
    period: 'Mai 2020 — Dez 2021',
    bullets: [
      'Construí o UI de um sistema de controle de acesso em React integrado com serviços backend via Axios.',
      'Solução cross-platform rodando em smart TVs, smartphones e qualquer dispositivo conectado.',
    ],
  },
  {
    role: 'Professor Tutor',
    company: 'SENAI',
    period: 'Jan 2021 — Jul 2022',
    bullets: [
      'Primeiro professor da turma de Desenvolvimento de Sistemas no estado — ensinei algoritmos, lógica e tecnologias web/desktop.',
    ],
  },
  {
    role: 'Freelancer Analyst',
    company: 'Diversas empresas',
    period: 'Jan 2016 — 2023',
    bullets: [
      'Integração de sistemas, automação de fluxos, configuração de servidores Linux e dashboards de dados em Python.',
    ],
  },
  {
    role: 'Network Engineer',
    company: 'Viavale Telecom',
    period: 'Fev 2015 — Jul 2015',
    bullets: [
      'Projetos de rotas em fibra óptica, configurações server-side e uso de AutoCAD, Python e Bash.',
    ],
  },
];

const education = [
  { title: 'Bacharel em Ciencia da Computação', institution: 'UNISC', year: '2013' },
  { title: 'Bacharel em Análise e Desenvolvimento de Sistemas', institution: 'Uninter', year: '2020' },
  { title: 'UI/UX', institution: 'FIAP', year: '2020' },
  { title: 'Machine Learning', institution: 'FIAP', year: '2021' },
  { title: 'Pós-graduação em Engenharia de Computação', institution: 'Uninter', year: '2022' },
  { title: 'Linux/Unix', institution: 'Cisco', year: '2022' },
  { title: 'Automation Engine', institution: 'Esko', year: '2026' },
  { title: 'Descomplicando o Go', institution: 'Linux Tips', year: '2026' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Sobre — ${SITE_TITLE}`} description="Engenheiro de software, músico e escritor. Trabalhando com tecnologia desde 2015." />
  </head>
  <body class="page-about">
    <Header />

    <!-- Profile hero -->
    <div class="profile-hero">
      <div class="container">
        <div class="profile-layout">
          <img src={avatarUrl} alt="Matheus" class="avatar" />
          <div class="profile-info">
            <span class="eyebrow">MTH / SOBRE</span>
            <h1 class="profile-name">Matheus</h1>
            <p class="profile-tagline">Trabalhando com tecnologia desde 2015 · Brasil</p>
            <p class="profile-bio">
              Trabalho com software desde 2015. Já passei por redes de fibra óptica,
              servidores Linux, salas de aula, front-end e liderança de projetos.
              Nas horas vagas, componho e escrevo sobre as coisas que me deixam curioso.
            </p>
            <div class="profile-actions">
              <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="action-link primary">
                Download CV (PDF)
              </a>
              <a href="/projects" class="action-link">Ver projetos</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container main">

      <!-- Skills -->
      <section class="section">
        <div class="section-label">Skills</div>
        <div class="skills-grid">
          <div class="skill-group">
            <span class="skill-category">Linguagens</span>
            <div class="skill-tags">
              {skills.languages.map((s) => <span class="tag">{s}</span>)}
            </div>
          </div>
          <div class="skill-group">
            <span class="skill-category">Tecnologias</span>
            <div class="skill-tags">
              {skills.technologies.map((s) => <span class="tag">{s}</span>)}
            </div>
          </div>
          <div class="skill-group">
            <span class="skill-category">Soft skills</span>
            <div class="skill-tags">
              {skills.soft.map((s) => <span class="tag">{s}</span>)}
            </div>
          </div>
        </div>
      </section>

      <!-- Experience -->
      <section class="section">
        <div class="section-label">Experiência</div>
        <div class="timeline">
          {experience.map((e) => (
            <div class="timeline-item">
              <div class="timeline-marker">
                <div class="timeline-dot"></div>
                <div class="timeline-line"></div>
              </div>
              <div class="timeline-content">
                <div class="timeline-header">
                  <div class="timeline-role-wrap">
                    <span class="timeline-role">{e.role}</span>
                    <span class="timeline-company">{e.company}</span>
                  </div>
                  <span class="timeline-period">{e.period}</span>
                </div>
                <ul class="timeline-bullets">
                  {e.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="section">
        <div class="section-label">Formação</div>
        <div class="edu-grid">
          {education.map((e) => (
            <div class="edu-item">
              <div class="edu-main">
                <span class="edu-title">{e.title}</span>
                <span class="edu-institution">{e.institution}</span>
              </div>
              <span class="edu-year">{e.year}</span>
            </div>
          ))}
        </div>
      </section>
    </div>

    <Footer />
  </body>
</html>
