---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={title}
      description={description}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
    />
  </head>

  <body>
    <Header />

    <article>
      <!-- Hero image full-bleed -->
      {heroImage && (
        <div class="post-hero-img">
          <Image
            width={1400}
            height={560}
            src={heroImage}
            alt={title}
            class="post-hero-img-el"
          />
          <div class="post-hero-overlay"></div>
        </div>
      )}

      <!-- Title block -->
      <div class="post-header" class:list={[!heroImage && 'post-header--no-image']}>
        <div class="post-header-inner">
          {tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )}
          <h1 class="post-title">{title}</h1>
          <p class="post-description">{description}</p>
          <div class="post-meta">
            <time class="post-date"><FormattedDate date={pubDate} /></time>
            {updatedDate && (
              <span class="post-updated">
                Atualizado em <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Article content -->
      <div class="prose">
        <slot />
      </div>
    </article>

    <!-- Back link -->
    <div class="back-wrap">
      <a href="/blog" class="back-link">← Voltar ao blog</a>
    </div>

    <Footer />
  </body>
</html>

<style>
  /* Hero image */
  .post-hero-img {
    position: relative;
    width: 100%;
    max-height: 520px;
    overflow: hidden;
  }

  .post-hero-img-el {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    display: block;
  }

  .post-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--bg) 100%);
  }

  /* Header block */
  .post-header {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .post-header--no-image {
    padding-top: 4.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .post-header-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--fg);
  }

  .post-description {
    font-size: 1.1rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .post-date {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg-muted);
    letter-spacing: 0.02em;
  }

  .post-updated {
    font-size: 0.78rem;
    font-style: italic;
    color: var(--fg-muted);
  }

  /* Back link */
  .back-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.15s;
    gap: 0.25rem;
  }

  .back-link:hover { color: var(--fg); }
</style>
