---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { readTime?: number };

const { title, description, pubDate, updatedDate, heroImage, tags, readTime } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={title}
      description={description}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
    />
  </head>

  <body class="page-post">
    <Header>
      <progress
        slot="reading-progress"
        id="reading-progress"
        aria-label="Progresso de leitura"
        max="1"
        value="0"
      ></progress>
    </Header>

    <article id="blog-post">
      <!-- Hero image full-bleed -->
      {heroImage && (
        <div class="post-hero-img">
          <Image
            width={1400}
            height={560}
            src={heroImage}
            alt={title}
            class="post-hero-img-el"
          />
          <div class="post-hero-overlay"></div>
        </div>
      )}

      <!-- Title block -->
      <div class="post-header" class:list={[!heroImage && 'post-header--no-image']}>
        <div class="post-header-inner">
          {tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )}
          <h1 class="post-title">{title}</h1>
          <p class="post-description">{description}</p>
          <div class="post-meta">
            <time class="post-date"><FormattedDate date={pubDate} /></time>
            {readTime && <span class="post-read-time">{readTime} min de leitura</span>}
            {updatedDate && (
              <span class="post-updated">
                Atualizado em <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Article content -->
      <div class="prose">
        <slot />
      </div>
    </article>

    <!-- Back link -->
    <div class="back-wrap">
      <a href="/blog" class="back-link">Voltar ao blog</a>
    </div>

    <Footer />
  </body>
</html>

<script>
  const progress = document.querySelector<HTMLProgressElement>('#reading-progress');
  const article = document.getElementById('blog-post');
  const header = document.getElementById('site-header');

  if (progress && article && header) {
    const updateProgress = () => {
      const { top, bottom } = article.getBoundingClientRect();
      const viewportBottom = document.documentElement.clientHeight;
      const scrolled = header.getBoundingClientRect().bottom - top;
      const remaining = bottom - viewportBottom;

      progress.value = remaining <= 0 ? 1 : Math.max(0, scrolled / (scrolled + remaining));
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    const observer = new ResizeObserver(updateProgress);
    observer.observe(article);
    observer.observe(header);
    updateProgress();
  }
</script>
