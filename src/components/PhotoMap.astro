---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import 'leaflet/dist/leaflet.css';

interface Props {
  photos: CollectionEntry<'img'>[];
}

const { photos } = Astro.props;
const located = photos.filter((photo) =>
  photo.data.location?.latitude !== undefined && photo.data.location.longitude !== undefined,
);
const points = await Promise.all(located.map(async (photo) => ({
  photo,
  thumbnail: (await getImage({ src: photo.data.image, width: 160, height: 120, fit: 'cover', format: 'webp' })).src,
})));
---

{points.length > 0 ? (
  <section class="photo-map-section" aria-label="Mapa das fotografias">
    <p class="map-count">{points.length} {points.length === 1 ? 'foto com localização' : 'fotos com localização'}</p>
    <div id="photo-map" class="map" role="region" aria-label="Mapa das fotografias" data-tile-url="https://tile.openstreetmap.org/{z}/{x}/{y}.png"></div>
    <ol id="photo-map-points" class="map-locations" aria-label="Fotografias no mapa">
      {points.map(({ photo, thumbnail }) => (
        <li
          data-lat={photo.data.location!.latitude}
          data-lng={photo.data.location!.longitude}
          data-title={photo.data.title ?? photo.data.alt}
          data-location={photo.data.location!.name}
          data-image={thumbnail}
          data-url={`/img/${photo.id}`}
        >
          <button type="button" class="place" aria-label={`Mostrar ${photo.data.location!.name} no mapa`}>{photo.data.location!.name}</button>
          <a class="photo-title" href={`/img/${photo.id}`} aria-label={`Abrir foto ${photo.data.title ?? photo.data.alt}`}>{photo.data.title ?? photo.data.alt}</a>
        </li>
      ))}
    </ol>
  </section>
) : (
  <p class="empty-map">Ainda não há fotografias com coordenadas para mostrar no mapa.</p>
)}

<script>
  import L from 'leaflet';

  const container = document.querySelector<HTMLElement>('#photo-map');
  const items = document.querySelectorAll<HTMLLIElement>('#photo-map-points li');

  if (container && items.length) {
    const map = L.map(container, { scrollWheelZoom: false }).setView([-15, -50], 3);
    L.tileLayer(container.dataset.tileUrl!, {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    type Place = { key: string; position: L.LatLng; photos: HTMLLIElement[] };
    const bounds: L.LatLngExpression[] = [];
    const places = new Map<string, Place>();
    for (const item of items) {
      const lat = Number(item.dataset.lat);
      const lng = Number(item.dataset.lng);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) continue;
      const position = L.latLng(lat, lng);
      const key = `${lat},${lng}`;
      if (!places.has(key)) {
        places.set(key, { key, position, photos: [] });
        bounds.push(position);
      }
      places.get(key)!.photos.push(item);
    }

    function makePopup(photos: HTMLLIElement[]) {
      const popup = document.createElement('div');
      popup.className = 'map-popup-list';
      for (const item of photos) {
        const link = document.createElement('a');
        link.className = 'map-popup';
        link.href = item.dataset.url!;
        const image = document.createElement('img');
        image.src = item.dataset.image!;
        image.alt = '';
        image.width = 160;
        image.height = 120;
        const label = document.createElement('span');
        label.textContent = `${item.dataset.title} · ${item.dataset.location}`;
        link.append(image, label);
        popup.append(link);
      }
      return popup;
    }

    const markerLayer = L.layerGroup().addTo(map);
    function renderMarkers(focusKey?: string) {
      markerLayer.clearLayers();
      const clusters: { places: Place[]; center: L.Point }[] = [];
      for (const place of places.values()) {
        const point = map.latLngToContainerPoint(place.position);
        const cluster = clusters.find((candidate) => candidate.center.distanceTo(point) < 48);
        if (cluster) {
          cluster.center = L.point(
            (cluster.center.x * cluster.places.length + point.x) / (cluster.places.length + 1),
            (cluster.center.y * cluster.places.length + point.y) / (cluster.places.length + 1),
          );
          cluster.places.push(place);
        } else {
          clusters.push({ places: [place], center: point });
        }
      }

      for (const cluster of clusters) {
        const photos = cluster.places.flatMap((place) => place.photos);
        if (cluster.places.length > 1) {
          const position = L.latLng(
            cluster.places.reduce((sum, place) => sum + place.position.lat, 0) / cluster.places.length,
            cluster.places.reduce((sum, place) => sum + place.position.lng, 0) / cluster.places.length,
          );
          const marker = L.marker(position, {
            title: `${photos.length} fotografias próximas`,
            icon: L.divIcon({
              className: 'photo-cluster',
              html: `<span>${photos.length}</span>`,
              iconSize: [40, 40],
              iconAnchor: [20, 20],
            }),
          }).addTo(markerLayer).bindPopup(makePopup(photos), { maxHeight: 320 });
          marker.on('click', () => {
            if (map.getZoom() >= 17) marker.openPopup();
            else map.setView(position, Math.min(map.getZoom() + 2, 17));
          });
        } else {
          const place = cluster.places[0];
          const marker = L.circleMarker(place.position, {
            radius: 9,
            color: '#fffaf1',
            weight: 2,
            fillColor: '#aa492e',
            fillOpacity: 1,
          }).addTo(markerLayer).bindPopup(makePopup(photos), { maxHeight: 320 });
          if (focusKey === place.key) marker.openPopup();
        }
      }
    }

    const selectedPhoto = new URLSearchParams(window.location.search).get('foto');
    const selectedPlace = [...places.values()].find((place) =>
      place.photos.some((photo) => photo.dataset.url === `/img/${selectedPhoto}`),
    );
    if (selectedPlace) map.setView(selectedPlace.position, 13);
    else {
      if (bounds.length === 1) map.setView(bounds[0], 11);
      else if (bounds.length > 1) map.fitBounds(bounds, { padding: [35, 35], maxZoom: 11 });
    }
    renderMarkers(selectedPlace?.key);
    map.on('zoomend moveend', () => renderMarkers());

    for (const item of items) {
      item.querySelector<HTMLButtonElement>('.place')?.addEventListener('click', () => {
        const place = places.get(`${item.dataset.lat},${item.dataset.lng}`);
        if (!place) return;
        map.setView(place.position, Math.max(map.getZoom(), 13), { animate: false });
        renderMarkers(place.key);
        container.scrollIntoView({ block: 'start' });
      });
    }
  }
</script>
