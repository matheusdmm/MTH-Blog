---
import type { CollectionEntry } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import ImgHeading from './ImgHeading.astro';
import ImgTabs from './ImgTabs.astro';
import PhotoGrid from './PhotoGrid.astro';
import { SITE_TITLE } from '../consts';

interface Props {
  photos: CollectionEntry<'img'>[];
}

const { photos } = Astro.props;
const counts = new Map<string, number>();
photos.forEach((photo) => new Set(photo.data.tags).forEach((tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1)));
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'pt-BR'));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead
      title={`Img — ${SITE_TITLE}`}
      description="Que mané instagram o que."
    />
  </head>
  <body>
    <Header />
    <main class="gallery-page">
      <ImgHeading />

      <ImgTabs active="photos" />

      {tags.length > 0 && (
        <div class="photo-filters" hidden>
          <div class="photo-filter-options" role="group" aria-label="Filtrar fotografias por assunto">
            <button type="button" data-photo-filter="" aria-pressed="true" aria-controls="photo-grid">
              Todas <span>{photos.length}</span>
            </button>
            {tags.map(([tag, count]) => (
              <button type="button" data-photo-filter={tag} aria-pressed="false" aria-controls="photo-grid">
                {tag} <span>{count}</span>
              </button>
            ))}
          </div>
          <p class="photo-filter-status" role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
      )}

      {photos.length > 0 ? (
        <PhotoGrid photos={photos} id="photo-grid" />
      ) : (
        <div class="empty-state">
          <p>Nenhum post.</p>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>

<script>
  const filters = document.querySelector<HTMLElement>('.photo-filters');
  const grid = document.querySelector<HTMLOListElement>('#photo-grid');
  const status = document.querySelector<HTMLElement>('.photo-filter-status');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-photo-filter]')];
  const items = [...document.querySelectorAll<HTMLLIElement>('#photo-grid > li')].map((item) => ({
    element: item,
    tags: JSON.parse(item.dataset.photoTags ?? '[]') as string[],
  }));

  if (filters && grid && status) {
    function applyFilter() {
      const url = new URL(window.location.href);
      const requested = url.searchParams.get('tag') ?? '';
      const tag = buttons.some((button) => button.dataset.photoFilter === requested) ? requested : '';
      // Unknown tags fall back to the complete gallery.
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      if (url.href !== window.location.href) window.history.replaceState(null, '', url);

      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.photoFilter === tag)));
      let count = 0;
      items.forEach(({ element, tags }) => {
        element.hidden = Boolean(tag) && !tags.includes(tag);
        if (!element.hidden) count++;
      });
      grid!.classList.toggle('is-filtered', Boolean(tag));
      status!.textContent = `${count} ${count === 1 ? 'foto' : 'fotos'}${tag ? ` · ${tag}` : ' no total'}`;
    }

    buttons.forEach((button) => button.addEventListener('click', () => {
      const url = new URL(window.location.href);
      const tag = button.dataset.photoFilter!;
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      if (url.href !== window.location.href) window.history.pushState(null, '', url);
      applyFilter();
    }));
    window.addEventListener('popstate', applyFilter);
    applyFilter();
    filters.hidden = false;
  }
</script>
