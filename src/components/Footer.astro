---
import { GITHUB, BANDCAMP, SUPPORT } from "../consts";
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <span class="copyright">© {year} Matheus</span>
    <nav class="footer-links" aria-label="Footer links">
      <a href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={BANDCAMP} target="_blank" rel="noopener noreferrer">Bandcamp</a>
      <a href={SUPPORT} target="_blank" rel="noopener noreferrer">Support</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.25rem 2rem;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-links a {
    font-size: 0.8rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.12s;
  }

  .footer-links a:hover { color: var(--fg); }

  @media (max-width: 480px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
