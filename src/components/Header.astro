---
import { SITE_TITLE, GITHUB, BANDCAMP } from '../consts';
import { getLangFromUrl, getOtherLocaleUrl, useTranslations } from '../i18n/translations';
import HeaderLink from './HeaderLink.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const targetLang = lang === 'pt-br' ? 'en' : 'pt-br';
const langToggleUrl = getOtherLocaleUrl(Astro.url.pathname, targetLang);
---

<header>
  <nav>
    <h2><a href={lang === 'en' ? '/en' : '/'}>{SITE_TITLE}</a></h2>
    <div class="internal-links">
      <HeaderLink href={lang === 'en' ? '/en' : '/'}>{t('nav.home')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/en/blog' : '/blog'}>{t('nav.blog')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/en/projects' : '/projects'}>{t('nav.projects')}</HeaderLink>
      <HeaderLink href={lang === 'en' ? '/en/about' : '/about'}>{t('nav.about')}</HeaderLink>
    </div>
    <div class="social-links">
      <a href={GITHUB} target="_blank">
        <span class="sr-only">Go to my GH Profile</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <a href={BANDCAMP} target="_blank">
        <span class="sr-only">Go to My Bandcamp</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
          ><path fill="currentColor" d="M0 18.75l7.437-13.5H24L16.563 18.75z"
          ></path></svg
        >
      </a>
      <a href="/kofi" target="_self">
        <span class="sr-only">Support me on Ko-fi</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
          ><path
            fill="currentColor"
            d="M2 21h18v-2H2M20 8h-2V5h2m0-2H4v10a4 4 0 004 4h6a4 4 0 004-4V9h2a2 2 0 002-2V5a2 2 0 00-2-2z"
          ></path></svg
        >
      </a>
    </div>
    <button
      id="theme-toggle"
      class="theme-toggle"
      aria-label="Toggle dark mode"
      data-dark={t('theme.dark')}
      data-light={t('theme.light')}
    >{t('theme.dark')}</button>
    <a href={langToggleUrl} class="lang-toggle" aria-label="Switch language">
      {t('lang.toggle')}
    </a>
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
</header>
<script>
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const menuBtn = document.getElementById('menu-toggle') as HTMLButtonElement;
  const headerEl = menuBtn.closest('header') as HTMLElement;

  function syncTheme() {
    const isDark =
      document.documentElement.getAttribute('data-theme') === 'dark';
    themeBtn.textContent = isDark
      ? (themeBtn.dataset.light ?? 'LIGHT')
      : (themeBtn.dataset.dark ?? 'DARK');
  }

  themeBtn.addEventListener('click', () => {
    const current =
      document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncTheme();
  });

  menuBtn.addEventListener('click', () => {
    const isOpen = headerEl.classList.toggle('menu-open');
    menuBtn.setAttribute('aria-expanded', String(isOpen));
  });

  syncTheme();
</script>
