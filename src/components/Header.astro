---
import { SITE_TITLE, GITHUB } from '../consts';
import HeaderLink from './HeaderLink.astro';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/blog', label: 'Blog' },
  { href: '/img', label: 'Img' },
  { href: '/projects', label: 'Projetos' },
  { href: '/about', label: 'Sobre' },
];
---

<header id="site-header">
  <div class="header-inner">
    <a href="/" class="site-name" aria-label="MTH — início">
      <img src="/favicon.svg" alt="" class="site-logo" width="28" height="28" />
      <span>{SITE_TITLE}<span class="site-mark">.</span></span>
    </a>

    <nav class="nav-links" aria-label="Navegação principal">
      {navLinks.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
      <a
        href={GITHUB}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-external">GitHub</a
      >
      <button id="theme-toggle" class="theme-btn" aria-label="Alternar tema claro ou escuro">
        <span class="icon-moon" aria-hidden="true">◗</span>
        <span class="icon-sun" aria-hidden="true">◖</span>
      </button>
    </nav>

    <button
      id="menu-toggle"
      class="menu-btn"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
    <a href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>
    <button
      id="theme-toggle-mobile"
      class="theme-btn-mobile"
      aria-label="Alternar tema claro ou escuro"
    >
      <span class="icon-moon-m" aria-hidden="true">◗</span>
      <span class="icon-sun-m" aria-hidden="true">◖</span>
      <span>Alternar tema</span>
    </button>
  </div>
</header>



<script>
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement;
  const menuBtn = document.getElementById('menu-toggle') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  const header = document.getElementById('site-header') as HTMLElement;

  function toggleTheme() {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'light'
        : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  }

  themeBtn?.addEventListener('click', toggleTheme);
  document
    .getElementById('theme-toggle-mobile')
    ?.addEventListener('click', toggleTheme);

  menuBtn?.addEventListener('click', () => {
    const open = header.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(open));
    mobileMenu.hidden = !open;
  });
</script>
