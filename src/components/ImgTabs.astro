---
interface Props {
  active: 'photos' | 'map';
}

const { active } = Astro.props;
---

<nav class="img-tabs" aria-label="Visualização das imagens">
  <a href="/img" aria-current={active === 'photos' ? 'page' : undefined}>Fotos</a>
  <a href="/img/mapa" aria-current={active === 'map' ? 'page' : undefined}>Mapa</a>
</nav>
