---
import { getLangFromUrl } from '../i18n/translations';

interface Props {
    date: Date;
}

const { date } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const locale = lang === 'en' ? 'en-US' : 'pt-BR';
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString(locale, {
            year: "numeric",
            month: "short",
            day: "numeric",
        })
    }
</time>
