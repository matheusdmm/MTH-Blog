---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: (CollectionEntry<'blog'> & { readTime?: number })[];
  id?: string;
}

const { posts, id } = Astro.props;
---

<ul class="post-list" id={id}>
  {posts.map((post, index) => (
    <li data-tags={post.data.tags?.join(',') ?? ''}>
      <div class="post-row">
        <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="post-info">
          <a href={`/blog/${post.id}/`} class="post-title">{post.data.title}</a>
          {post.data.description && <span class="post-desc">{post.data.description}</span>}
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="post-tags">
              {post.data.tags.map((t) => <a href={`/blog?tag=${t}`} class="tag">{t}</a>)}
            </span>
          )}
        </div>
        <span class="post-date">
          <FormattedDate date={post.data.pubDate} />
          {post.readTime && <span class="read-time">· {post.readTime} min</span>}
        </span>
      </div>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .post-list li { border-bottom: 1px solid var(--border); }

  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 1.5rem;
    padding: 1.9rem 0;
    color: var(--fg);
  }

  .post-number { color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .06em; padding-top: .6rem; }

  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-title {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: clamp(1.35rem, 1.9vw, 1.8rem);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.1;
    text-decoration: none;
    transition: color 0.12s;
  }

  .post-title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-row:hover .post-title { color: var(--accent); }

  .post-tags .tag {
    position: relative;
    z-index: 1;
    text-decoration: none;
  }

  .post-tags .tag:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }

  .post-date {
    font-size: 0.72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    white-space: nowrap;
    padding-top: 0.15rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .read-time {
    font-size: 0.72rem;
    color: var(--fg-muted);
    opacity: 0.7;
  }

  @media (max-width: 520px) {
    .post-row { grid-template-columns: 2rem 1fr; gap: .5rem; }
    .post-date { grid-column: 2; padding-top: 0; align-items: flex-start; }
  }
</style>
