---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: (CollectionEntry<'blog'> & { readTime?: number })[];
  id?: string;
}

const { posts, id } = Astro.props;
---

<ul class="post-list" id={id}>
  {posts.map((post) => (
    <li data-tags={post.data.tags?.join(',') ?? ''}>
      <div class="post-row">
        <div class="post-info">
          <a href={`/blog/${post.id}/`} class="post-title">{post.data.title}</a>
          {post.data.description && <span class="post-desc">{post.data.description}</span>}
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="post-tags">
              {post.data.tags.map((t) => <a href={`/blog?tag=${t}`} class="tag">{t}</a>)}
            </span>
          )}
        </div>
        <span class="post-date">
          <FormattedDate date={post.data.pubDate} />
          {post.readTime && <span class="read-time">· {post.readTime} min</span>}
        </span>
      </div>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .post-list li { border-bottom: 1px solid var(--border); }

  .post-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 0;
    color: var(--fg);
  }

  .post-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-title {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.12s;
  }

  .post-title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-title:hover { color: var(--accent-hover); }

  .post-tags .tag {
    position: relative;
    z-index: 1;
    text-decoration: none;
  }

  .post-tags .tag:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  .post-desc {
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
  }

  .post-date {
    font-size: 0.78rem;
    color: var(--fg-muted);
    white-space: nowrap;
    padding-top: 0.15rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .read-time {
    font-size: 0.72rem;
    color: var(--fg-muted);
    opacity: 0.7;
  }

  @media (max-width: 520px) {
    .post-row { flex-direction: column; gap: 0.4rem; }
    .post-date { padding-top: 0; }
  }
</style>
