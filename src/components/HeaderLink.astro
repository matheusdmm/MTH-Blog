---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { exact?: boolean };

const { href, class: className, exact, ...props } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = href === pathname || (!exact && !!href && pathname.startsWith(href + '/'));
---

<a
    href={href}
    class:list={[className, "header-link", { active: isActive }]}
    {...props}
>
    <slot />
</a>
